<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forcer le HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.gregory-lacroix-pf.com%{REQUEST_URI} [L,R=301]

  # Forcer www
  RewriteCond %{HTTP_HOST} !^www\.gregory-lacroix-pf\.com$ [NC]
  RewriteRule ^(.*)$ https://www.gregory-lacroix-pf.com/$1 [L,R=301]
  RewriteCond %{REQUEST_URI} !dist/
  RewriteRule (.*) /dist/$1 [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

